{
  "url": "/offers",
  "method": "GET",
  "qs": {
    "in_stock_only": "true",
    "sort": "recommended",
    "limit": 100,
    "page": 1
  },
  "response": {
    "iterate": "{{body.data}}",
    "limit": 500,
    "output": {
      "label": "{{item.name}} — payout {{item.payout}} UZS (#{{item.id}})",
      "value": "{{item.id}}"
    }
  },
  "pagination": {
    "qs": {
      "page": "{{pagination.page}}"
    },
    "condition": "{{body.meta.page < body.meta.total_pages}}"
  }
}
