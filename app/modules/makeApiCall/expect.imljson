[
  {
    "name": "url",
    "type": "text",
    "label": "URL",
    "required": true,
    "help": "Path relative to `https://birinchishop.uz/api/v1/`, e.g. `/offers`. See https://birinchishop.uz/api/v1/docs. Note: `POST /orders` with a live key creates a REAL order."
  },
  {
    "name": "method",
    "type": "select",
    "label": "Method",
    "required": true,
    "default": "GET",
    "options": [
      {
        "label": "GET",
        "value": "GET"
      },
      {
        "label": "POST",
        "value": "POST"
      },
      {
        "label": "PATCH",
        "value": "PATCH"
      },
      {
        "label": "DELETE",
        "value": "DELETE"
      }
    ]
  },
  {
    "name": "headers",
    "type": "array",
    "label": "Headers",
    "spec": [
      {
        "name": "key",
        "type": "text",
        "label": "Key"
      },
      {
        "name": "value",
        "type": "text",
        "label": "Value"
      }
    ],
    "default": [
      {
        "key": "Content-Type",
        "value": "application/json"
      }
    ],
    "help": "Authorization is added automatically."
  },
  {
    "name": "qs",
    "type": "array",
    "label": "Query String",
    "spec": [
      {
        "name": "key",
        "type": "text",
        "label": "Key"
      },
      {
        "name": "value",
        "type": "text",
        "label": "Value"
      }
    ]
  },
  {
    "name": "body",
    "type": "any",
    "label": "Body",
    "help": "JSON text for POST/PATCH."
  }
]
