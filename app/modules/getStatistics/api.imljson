{
  "url": "/stats",
  "method": "GET",
  "qs": {
    "group_by": "{{parameters.group_by}}",
    "date_from": "{{if(parameters.date_from, formatDate(parameters.date_from, 'YYYY-MM-DD'), undefined)}}",
    "date_to": "{{if(parameters.date_to, formatDate(parameters.date_to, 'YYYY-MM-DD'), undefined)}}",
    "offer_id": "{{parameters.offer_id}}",
    "link_id": "{{parameters.link_id}}"
  },
  "response": {
    "output": {
      "{{...}}": "{{body.meta}}",
      "rows": "{{body.data}}"
    }
  }
}
