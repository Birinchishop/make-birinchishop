{
  "url": "/links",
  "method": "POST",
  "type": "json",
  "body": {
    "offer_id": "{{parameters.offer_id}}",
    "name": "{{parameters.name}}"
  },
  "response": {
    "output": {
      "{{...}}": "{{omit(body.data, 'created_at')}}",
      "created_at": "{{parseDate(body.data.created_at, 'YYYY-MM-DDTHH:mm:ssZ')}}"
    }
  }
}
