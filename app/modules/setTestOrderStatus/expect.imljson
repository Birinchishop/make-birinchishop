        "value": "confirmed"
      },
      {
        "label": "Packed",
        "value": "packed"
      },
      {
        "label": "Shipping",
        "value": "shipping"
      },
      {
        "label": "Delivered (payout earned)",
        "value": "delivered"
      },
      {
        "label": "Returned (refused at delivery)",
        "value": "returned"
      },
      {
        "label": "Canceled (no payout)",
        "value": "cancelled"
      }
    ]
  }
