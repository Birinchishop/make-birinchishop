{
  "url": "/sandbox/orders/{{parameters.order_id}}/status",
  "method": "POST",
  "type": "json",
  "body": {
    "status": "{{parameters.status}}"
  },
  "response": {
    "output": {
      "{{...}}": "{{omit(body.data, 'order')}}",
      "order": "{{parseDateFields(body.data.order)}}"
    }
  }
}
