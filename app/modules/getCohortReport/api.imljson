{
  "url": "/stats/cohorts",
  "method": "GET",
  "qs": {
    "weeks": "{{parameters.weeks}}",
    "offer_id": "{{parameters.offer_id}}",
    "link_id": "{{parameters.link_id}}",
    "source": "{{parameters.source}}"
  },
  "response": {
    "output": {
      "{{...}}": "{{body.meta}}",
      "cohorts": "{{body.data}}"
    }
  }
}
