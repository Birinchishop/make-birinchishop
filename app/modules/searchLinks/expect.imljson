[
  {
    "name": "offer_id",
    "type": "select",
    "label": "Offer",
    "options": "rpc://listOffers",
    "help": "In-stock offers are listed; you can also map an offer ID."
  },
  {
    "name": "limit",
    "type": "uinteger",
    "label": "Limit",
    "default": 10,
    "validate": {
      "min": 1
    },
    "help": "Maximum number of bundles this module returns in one execution. Leave empty to return all results."
  }
]
