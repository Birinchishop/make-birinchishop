{
  "url": "/events",
  "method": "GET",
  "qs": {
    "after": "{{data.lastId}}",
    "limit": 200,
    "include_order": "true",
    "type": "{{parameters.type}}"
  },
  "response": {
    "iterate": "{{body.data}}",
    "limit": "{{parameters.limit}}",
    "trigger": {
      "id": "{{item.id}}",
      "type": "id",
      "order": "asc"
    },
    "output": {
      "{{...}}": "{{omit(item, 'created_at')}}",
      "created_at": "{{parseDate(item.created_at, 'YYYY-MM-DDTHH:mm:ssZ')}}"
    }
  },
  "pagination": {
    "qs": {
      "after": "{{body.meta.next_cursor}}"
    },
    "condition": "{{body.meta.has_more}}"
  }
}
