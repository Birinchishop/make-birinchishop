[
  {
    "name": "date_from",
    "type": "text",
    "label": "Date from",
    "validate": {
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "help": "First day (Asia/Tashkent), `YYYY-MM-DD`. Default: 29 days before Date to."
  },
  {
    "name": "date_to",
    "type": "text",
    "label": "Date to",
    "validate": {
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "help": "Last day (Asia/Tashkent), `YYYY-MM-DD`. Default: today."
  }
]
