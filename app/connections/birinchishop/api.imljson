{
  "url": "https://birinchishop.uz/api/v1/me",
  "method": "GET",
  "headers": {
    "Authorization": "Bearer {{parameters.apiKey}}",
    "Accept": "application/json",
    "User-Agent": "birinchishop-make/1.0"
  },
  "response": {
    "metadata": {
      "type": "text",
      "value": "{{body.data.name}} ({{body.data.api_key.mode}} key)"
    },
    "error": {
      "message": "[{{statusCode}}] {{ifempty(body.error.message, 'Unexpected response')}} (code: {{ifempty(body.error.code, 'none')}})"
    }
  },
  "log": {
    "sanitize": [
      "request.headers.authorization"
    ]
  }
}
