{
  "baseUrl": "https://birinchishop.uz/api/v1",
  "headers": {
    "Authorization": "Bearer {{connection.apiKey}}",
    "Accept": "application/json",
    "User-Agent": "birinchishop-make/1.0"
  },
  "response": {
    "error": {
      "400": {
        "type": "DataError",
        "message": "[400] {{ifempty(body.error.message, 'Unexpected response')}} (code: {{ifempty(body.error.code, 'none')}}, request ID: {{ifempty(body.request_id, 'none')}})"
      },
      "401": {
        "type": "InvalidAccessTokenError",
        "message": "[401] {{ifempty(body.error.message, 'Unexpected response')}} (code: {{ifempty(body.error.code, 'none')}}). Check or recreate the API key in Dashboard → API."
      },
      "403": {
        "type": "{{if(body.error.code === 'insufficient_scope' || body.error.code === 'not_available_in_test_mode' || body.error.code === 'ip_not_allowed' || body.error.code === 'account_blocked' || body.error.code === 'test_mode_only', 'InvalidConfigurationError', 'DataError')}}",
        "message": "[403] {{ifempty(body.error.message, 'Unexpected response')}} (code: {{ifempty(body.error.code, 'none')}}, request ID: {{ifempty(body.request_id, 'none')}}). For insufficient_scope, grant the scope to the key in Dashboard → API."
      },
      "409": {
        "type": "DuplicateDataError",
        "message": "[409] {{ifempty(body.error.message, 'Unexpected response')}} (code: {{ifempty(body.error.code, 'none')}}, request ID: {{ifempty(body.request_id, 'none')}}). Do not retry this request."
      },
      "message": "[{{statusCode}}] {{ifempty(body.error.message, 'Unexpected response')}} (code: {{ifempty(body.error.code, 'none')}}, request ID: {{ifempty(body.request_id, 'none')}})"
    }
  },
  "log": {
    "sanitize": [
      "request.headers.authorization"
    ]
  }
}
