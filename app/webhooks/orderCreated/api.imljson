{
  "condition": "{{body.type === 'order.created' && body.data.order_id > 0}}",
  "respond": {
    "status": 200,
    "type": "json",
    "body": {
      "received": true
    }
  },
  "output": {
    "event_id": "{{body.id}}",
    "type": "{{body.type}}",
    "api_version": "{{body.api_version}}",
    "created_at": "{{body.created_at}}",
    "order_id": "{{body.data.order_id}}",
    "status": "{{body.data.status}}",
    "previous_status": "{{body.data.previous_status}}",
    "test": "{{body.test === true}}"
  }
}
