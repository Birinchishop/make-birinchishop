{
  "url": "/webhooks",
  "method": "POST",
  "type": "json",
  "body": {
    "url": "{{webhook.url}}",
    "kind": "json",
    "events": [
      "order.status_changed"
    ],
    "description": "Make: Birinchishop: order status changed"
  },
  "response": {
    "data": {
      "externalHookId": "{{body.data.id}}",
      "secret": "{{body.data.secret}}"
    },
    "error": {
      "message": "[{{statusCode}}] {{ifempty(body.error.message, 'Unexpected response')}} (code: {{ifempty(body.error.code, 'none')}}). The account can have at most 10 webhooks; remove unused ones in Dashboard → API → Webhooks."
    }
  },
  "log": {
    "sanitize": [
      "request.body.url",
      "response.body.data.secret",
      "response.body.data.url"
    ]
  }
}
